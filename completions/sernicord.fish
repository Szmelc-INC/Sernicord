# fish completion for sernicord
set -l cmds dev up menu setup sync-plugins build watch inject uninject launch fix update upgrade self-update check rebuild repair reinstall restart logs doctor status stop profiles backup restore scan clean-build completion version help

complete -c sernicord -f
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a dev -d 'Build, sync, inject, watch, launch (default)'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a up -d 'Alias for dev'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a menu -d 'Interactive menu'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a setup -d 'Clone target, install deps, fetch Discord'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a sync-plugins -d 'Copy plugins into target'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a build -d 'Build target'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a watch -d 'Rebuild on save'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a inject -d 'Inject into profile Discord'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a uninject -d 'Remove injection'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a launch -d 'Launch isolated Discord'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a fix -d 'Re-inject after Discord update'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a update -d 'Pull, deps, rebuild, reinject'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a upgrade -d 'Full auto update: repo, targets, deps, Discord, build'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a self-update -d 'Alias for upgrade'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a check -d 'Scan + type-check plugins against target API'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a rebuild -d 'Clean dist, full build, verify'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a repair -d 'Fix pnpm, stale watch, rebuild, reinject'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a reinstall -d 'Wipe deps + dist, reinstall, rebuild, reinject'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a restart -d 'Stop everything, then dev'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a logs -d 'Show the watch log'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a doctor -d 'Check toolchain and fences'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a status -d 'Show profiles and PIDs'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a stop -d 'Stop watch and Discord'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a profiles -d 'List profiles'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a backup -d 'Zip configs, themes, QuickCSS, plugins, session'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a restore -d 'Restore a sernicord backup zip'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a scan -d 'Find other Discord/Vencord traces'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a clean-build -d 'Remove target dist/'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a completion -d 'Print shell completion'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a version -d 'Print version'
complete -c sernicord -n "not __fish_seen_subcommand_from $cmds" -a help -d 'Show help'
complete -c sernicord -n "__fish_seen_subcommand_from completion" -a 'bash zsh fish'

complete -c sernicord -l target -x -a 'vencord equicord' -d 'Mod tree'
complete -c sernicord -l profile -x -d 'Isolated data profile'
complete -c sernicord -l channel -x -a 'stable ptb canary' -d 'Discord channel'
complete -c sernicord -l system -d 'DANGEROUS: operate on system Discord'
complete -c sernicord -l no-launch -d 'Skip launching Discord'
complete -c sernicord -l no-watch -d 'Skip file watch'
complete -c sernicord -l prod -d 'Production build'
complete -c sernicord -s y -l yes -d 'Assume yes'
complete -c sernicord -s f -l follow -d 'Follow the log (logs)'
complete -c sernicord -s h -l help -d 'Show help'
complete -c sernicord -s V -l version -d 'Print version'

complete -c sernicord -n "__fish_seen_subcommand_from restore" -a "(__fish_complete_path '*.zip')"
complete -c sernicord -n "__fish_seen_subcommand_from scan" -l import -x -a 'settings themes quickcss cache plugins all' -d 'Import scope'
complete -c sernicord -n "__fish_seen_subcommand_from scan" -l from -r -a "(__fish_complete_directories)" -d 'Import source'
complete -c sernicord -l no-color -d 'Disable colors (honors NO_COLOR)'
complete -c sernicord -l full -d 'Backup: include Chromium caches'
complete -c sernicord -l plugins-only -d 'Backup/restore: plugins only'
complete -c sernicord -l data-only -d 'Restore: profile data only'
complete -c sernicord -n "__fish_seen_subcommand_from upgrade self-update" -l no-self -d 'Upgrade: skip the repo pull'
complete -c sernicord -n "__fish_seen_subcommand_from upgrade self-update" -l no-build -d 'Upgrade: skip build + reinject'
