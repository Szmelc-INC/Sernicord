cmd_update() {
  local src
  ensure_toolchain
  ensure_target_clone
  src=$(target_src "$TARGET")
  info "Updating $TARGET (git pull)..."
  (cd "$src" && git pull --ff-only || git pull --rebase || warn "git pull had issues — continuing")
  (cd "$src" && host pnpm install)
  sync_plugins
  build_target
  inject_target
  ok "Updated + reinjected"
}

git_head() {
  git -C "$1" rev-parse --short HEAD 2>/dev/null || echo "-"
}

# Pull a checkout from its upstream. Local edits to files upstream did not touch
# are autostashed and reapplied; if upstream changed a locally edited file the
# pull is skipped (an autostash would leave conflict markers in it). A failed
# rebase rolls back instead of leaving a half-done one.
pull_tree() {
  local dir="$1" label="$2" before after overlap
  if ! git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    warn "$label: not a git checkout — skipped"
    return 0
  fi
  before=$(git_head "$dir")
  if ! git -C "$dir" fetch --prune --tags --quiet; then
    warn "$label: fetch failed — still at $before"
    return 0
  fi
  if ! git -C "$dir" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
    warn "$label: branch '$(git -C "$dir" branch --show-current)' has no upstream — fetched only ($before)"
    return 0
  fi
  overlap=$(comm -12 \
    <(git -C "$dir" diff --name-only HEAD | sort -u) \
    <(git -C "$dir" diff --name-only "HEAD...@{u}" | sort -u))
  if [[ -n "$overlap" ]]; then
    warn "$label: upstream changed files you edited locally — not pulled (still $before):"
    printf '      %s\n' $overlap >&2
    note "commit or stash them, then run upgrade again"
    return 0
  fi
  if ! git -C "$dir" pull --rebase --autostash --quiet; then
    git -C "$dir" rebase --abort >/dev/null 2>&1 || true
    warn "$label: pull failed (conflict with local changes?) — left at $before"
    return 0
  fi
  after=$(git_head "$dir")
  if [[ "$before" == "$after" ]]; then
    ok "$label: up to date ($after)"
  else
    ok "$label: $before → $after"
    git -C "$dir" log --oneline --no-decorate "$before..$after" 2>/dev/null | head -15 | sed 's/^/      /'
  fi
}

# Overwrite completion files the user already installed (never installs new ones)
refresh_completions() {
  local dir="${SERNICORD_COMPLETIONS:-$ROOT/completions}" data cfg pair dst n=0
  data="${HOST_XDG_DATA_HOME:-$HOME/.local/share}"
  cfg="${HOST_XDG_CONFIG_HOME:-$HOME/.config}"
  for pair in \
    "sernicord.bash:$data/bash-completion/completions/sernicord" \
    "_sernicord:$data/zsh/site-functions/_sernicord" \
    "sernicord.fish:$cfg/fish/completions/sernicord.fish"; do
    dst="${pair#*:}"
    [[ -f "$dst" && -f "$dir/${pair%%:*}" ]] || continue
    cp -f "$dir/${pair%%:*}" "$dst" && n=$((n + 1))
  done
  if (( n )); then ok "Refreshed $n installed completion file(s)"; else note "No user-installed completions to refresh"; fi
}

# Full auto update: Sernicord itself, every cloned target, deps, missing
# Discord pieces, completions, plugins, build, reinject.
cmd_upgrade() {
  local t src self_sum before_plugins after_plugins added was_watching=0
  ensure_toolchain
  before_plugins="${SERNICORD_PLUGINS_BEFORE:-$(ls "$PLUGINS_DIR" 2>/dev/null | tr '\n' ' ')}"

  hdr "Sernicord"
  if (( UPGRADE_NO_SELF )); then
    note "Self update skipped (--no-self)"
  elif git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    self_sum=$(sha256sum "$ROOT/sernicord" | cut -d' ' -f1)
    pull_tree "$ROOT" "sernicord"
    if [[ "$(sha256sum "$ROOT/sernicord" | cut -d' ' -f1)" != "$self_sum" ]]; then
      info "The sernicord script changed — continuing with the new version"
      SERNICORD_PLUGINS_BEFORE="$before_plugins" exec "$ROOT/sernicord" "${ORIG_ARGS[@]}" --no-self
    fi
  else
    warn "Packaged install (no git checkout at $ROOT) — update the package itself: yay -Syu sernicord-git / nix profile upgrade"
  fi

  hdr "Targets"
  ensure_target_clone
  for t in vencord equicord; do
    src=$(target_src "$t")
    [[ -f "$src/package.json" ]] || continue
    pull_tree "$src" "$t"
    info "$t: installing dependencies"
    (cd "$src" && { host pnpm install --frozen-lockfile || host pnpm install; }) || warn "$t: pnpm install had issues"
  done

  hdr "Completions"
  refresh_completions

  hdr "Discord"
  mkdir -p "$ROOT/discord-app"
  apply_profile_env
  ensure_discord_bootstrap
  ensure_client
  ok "Discord bootstrap + client present ($CHANNEL, profile $PROFILE)"

  hdr "Plugins + build"
  if (( NO_BUILD )); then
    sync_plugins
    note "Build skipped (--no-build) — run ./sernicord rebuild when ready"
  else
    watch_running && was_watching=1
    (( was_watching )) && stop_watch
    build_target
    inject_target
    (( was_watching )) && start_watch
  fi

  after_plugins=$(ls "$PLUGINS_DIR" 2>/dev/null | tr '\n' ' ')
  added=$(comm -13 <(tr ' ' '\n' <<<"$before_plugins" | sort -u) <(tr ' ' '\n' <<<"$after_plugins" | sort -u) | grep -v '^$' | tr '\n' ' ' || true)
  hdr "Done"
  kv "sernicord" "$(git_head "$ROOT")"
  kv "$TARGET" "$(git_head "$(target_src "$TARGET")")"
  [[ -n "$added" ]] && kv "new plugins" "$AQUA$added$RST"
  ok "Upgrade complete — restart Discord (or Ctrl+R) to load it"
}

cmd_fix() {
  info "Fix: rebuild plugins sync + reinject (post Discord update)"
  ensure_toolchain
  apply_profile_env
  ensure_target_clone
  ensure_deps
  sync_plugins
  build_target
  inject_target
  ok "Fixed. Restart Discord or ./sernicord launch"
}

# Kill watchers of this target that lost their pid file (they keep rewriting dist/)
kill_orphan_watch() {
  local src pid
  src=$(realpath "$(target_src "$TARGET")")
  for pid in $(pgrep -f 'scripts/build/build.mjs --watch' || true); do
    [[ "$(realpath "/proc/$pid/cwd" 2>/dev/null)" == "$src" ]] || continue
    kill "$pid" 2>/dev/null && ok "Killed orphan watch pid $pid"
  done
  return 0
}

cmd_rebuild() {
  local was_watching=0
  ensure_toolchain
  ensure_target_clone
  watch_running && was_watching=1
  stop_watch
  cmd_clean_build
  build_target
  (( was_watching )) && start_watch
  ok "Rebuilt $TARGET (${DIST_FILES[*]})"
}

cmd_repair() {
  local was_watching=0
  info "Repair: toolchain → stale processes → plugin check → clean build → reinject"
  ensure_toolchain
  ensure_target_clone
  repair_pnpm
  watch_running && was_watching=1
  stop_watch
  apply_profile_env
  clear_stale_singleton
  ensure_deps
  cmd_check || warn "Continuing; the build below fails if these errors are fatal"
  cmd_clean_build
  build_target
  inject_target
  (( was_watching )) && start_watch
  ok "Repaired. Restart Discord or run ./sernicord launch"
}

cmd_reinstall() {
  local src
  src=$(target_src "$TARGET")
  confirm "Reinstall $TARGET: stop, uninject, delete node_modules + dist, reinstall deps, rebuild, reinject?" || die "Aborted"
  ensure_toolchain
  ensure_target_clone
  apply_profile_env
  stop_all
  is_patched && uninject_target
  info "Removing $src/node_modules and $src/dist"
  rm -rf "$src/node_modules" "$src/dist"
  repair_pnpm
  ensure_deps
  build_target
  inject_target
  ok "Reinstalled $TARGET for profile '$PROFILE'"
}

cmd_logs() {
  local log
  log=$(watch_log_file)
  [[ -f "$log" ]] || die "No watch log yet: $log"
  if (( FOLLOW )); then
    tail -n 50 -f "$log"
  else
    tail -n "${CMD_ARG:-80}" "$log"
  fi
}

cmd_doctor() {
  local src cfg app issues=0
  printf '%s\n' "${BLD}Sernicord doctor${RST}"
  printf '  root:    %s\n' "$ROOT"
  printf '  target:  %s\n' "$TARGET"
  printf '  profile: %s\n' "$PROFILE"
  printf '  channel: %s\n' "$CHANNEL"
  printf '  system:  %s\n' "$( ((USE_SYSTEM)) && echo YES || echo no )"
  echo

  for c in git node pnpm rsync python3; do
    if command -v "$c" >/dev/null 2>&1; then
      ok "tool $c = $(command -v "$c")"
    else
      warn "missing tool: $c"
      issues=$((issues + 1))
    fi
  done

  src=$(target_src "$TARGET")
  if [[ -f "$src/package.json" ]]; then
    ok "target source $src"
  else
    warn "target missing — run ./sernicord setup"
    issues=$((issues + 1))
  fi
  if [[ -d "$src/node_modules" ]]; then ok "node_modules present"; else warn "no node_modules"; issues=$((issues+1)); fi
  if dist_complete; then
    ok "dist complete (${DIST_FILES[*]})"
  else
    warn "dist incomplete, missing: $(dist_missing) — run ./sernicord repair"
    issues=$((issues+1))
  fi
  if (cd "$src" 2>/dev/null && host pnpm -v >/dev/null 2>&1); then
    ok "pnpm works in target ($(cd "$src" && host pnpm -v))"
  else
    warn "pnpm fails in $src — run ./sernicord repair"
    issues=$((issues+1))
  fi
  if watch_running && [[ -f "$(watch_log_file)" ]] && tail -n 40 "$(watch_log_file)" | grep -q '\[ERROR\]'; then
    warn "watch log has build errors — run ./sernicord logs"
    issues=$((issues+1))
  fi

  local plug_count=0
  for d in "$PLUGINS_DIR"/*/; do [[ -d "$d" ]] && plug_count=$((plug_count+1)); done
  ok "publishable plugins: $plug_count (plugins/)"

  cfg=$(discord_config)
  printf '  discord config: %s\n' "$cfg"
  if [[ -d "$cfg" ]]; then ok "config dir exists"; else warn "config dir missing"; issues=$((issues+1)); fi
  if is_patched; then
    app=$(newest_app)
    ok "patched: $app"
  else
    warn "not patched — run ./sernicord inject"
    issues=$((issues + 1))
  fi

  if [[ -x "$(bootstrap_bin)" ]]; then ok "bootstrap ok"; else warn "bootstrap missing — run ./sernicord setup"; issues=$((issues+1)); fi
  if [[ -x "$(launcher_bin)" ]]; then ok "launcher ok"; else warn "launcher missing — run ./sernicord setup"; issues=$((issues+1)); fi

  echo
  info "Privacy fence"
  if [[ -f "$ROOT/.gitignore" ]] && grep -q '^/data/' "$ROOT/.gitignore"; then
    ok ".gitignore fences data/"
  else
    warn ".gitignore missing data/ fence"
    issues=$((issues + 1))
  fi
  if [[ -x "$ROOT/scripts/secret-scan.sh" ]]; then
    ok "secret-scan.sh present"
  else
    warn "secret-scan.sh missing"
    issues=$((issues + 1))
  fi
  local hooks
  if git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    hooks=$(git -C "$ROOT" config --get core.hooksPath 2>/dev/null || true)
    if [[ "$hooks" == ".githooks" ]]; then
      ok "core.hooksPath=.githooks"
    else
      warn "git hooks not installed (run: git config core.hooksPath .githooks)"
      issues=$((issues + 1))
    fi
  else
    ok "not a git checkout — commit hooks not applicable"
  fi

  # Spot-check that data is not tracked
  if git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    if git -C "$ROOT" ls-files --error-unmatch data >/dev/null 2>&1; then
      warn "data/ appears tracked by git — UNSAFE"
      issues=$((issues + 1))
    else
      ok "data/ not tracked"
    fi
  fi

  echo
  if (( issues )); then
    warn "Doctor found $issues issue(s)"
    return 1
  fi
  ok "All checks passed"
}

cmd_status() {
  local src cfg f
  src=$(target_src "$TARGET")
  cfg=$(discord_config)
  f=$(watch_pid_file)
  echo "${BLD}Sernicord status${RST}"
  echo "  target:  $TARGET @ $src"
  echo "  profile: $PROFILE"
  echo "  config:  $cfg"
  if watch_running; then
    echo "  watch:   running pid $(cat "$f")"
  else
    echo "  watch:   stopped"
  fi
  if is_patched; then
    echo "  patch:   $(newest_app)"
  else
    echo "  patch:   none"
  fi
  if pgrep -f "$cfg" >/dev/null 2>&1; then
    echo "  discord: running"
  else
    echo "  discord: stopped"
  fi
  echo
  echo "Profiles under data/profiles/:"
  if [[ -d "$ROOT/data/profiles" ]]; then
    find "$ROOT/data/profiles" -mindepth 1 -maxdepth 1 -type d -printf '  %f\n' 2>/dev/null || true
  fi
  if [[ -d "$ROOT/data/config/discord" ]]; then
    echo "  (legacy default layout: data/config/discord)"
  fi
  echo
  echo "Plugins:"
  for d in "$PLUGINS_DIR"/*/; do
    [[ -d "$d" ]] && echo "  - $(basename "$d")"
  done
}

cmd_profiles() {
  echo "Available / known profiles:"
  echo "  * $DEFAULT_PROFILE (default)"
  if [[ -d "$ROOT/data/profiles" ]]; then
    find "$ROOT/data/profiles" -mindepth 1 -maxdepth 1 -type d -printf '  - %f\n' 2>/dev/null || true
  fi
  if [[ -d "$ROOT/data/config/discord" ]]; then
    echo "  - legacy data/config/discord (mapped to default profile when present)"
  fi
}

cmd_clean_build() {
  local src
  src=$(target_src "$TARGET")
  rm -rf "$src/dist"
  ok "Removed $src/dist"
}

cmd_menu() {
  ensure_toolchain
  if [[ ! -t 0 ]]; then die "menu requires an interactive terminal"; fi
  while true; do
    cat <<EOF

${BLD}${MAG}Sernicord${RST}  target=${CYN}$TARGET${RST}  profile=${CYN}$PROFILE${RST}  channel=${CYN}$CHANNEL${RST}
  1) Dev (build+inject+watch+launch)     7) Fix / reinject
  2) Setup                               8) Update target
  3) Sync plugins                        9) Doctor
  4) Build                               10) Status
  5) Inject                              11) Stop
  6) Launch                              12) Switch target/profile
  13) Check plugins                      15) Repair (full)
  14) Rebuild (clean)                    16) Reinstall deps
  17) Watch log                          18) Backup (zip)
  19) Restore backup                     20) Scan for Discord traces
  21) Full upgrade (repo + targets + build)
  0) Quit
EOF
    local choice
    read -r -p "Choice: " choice
    case "$choice" in
      1) cmd_dev || true; break ;;
      2) cmd_setup || true ;;
      3) sync_plugins || true ;;
      4) build_target || true ;;
      5) inject_target || true ;;
      6) launch_discord || true; break ;;
      7) cmd_fix || true ;;
      8) cmd_update || true ;;
      9) cmd_doctor || true ;;
      10) cmd_status || true ;;
      11) stop_all || true ;;
      12)
        read -r -p "Target [vencord/equicord] ($TARGET): " t
        read -r -p "Profile ($PROFILE): " p
        read -r -p "Channel [stable/ptb/canary] ($CHANNEL): " c
        [[ -n "${t:-}" ]] && TARGET="$t"
        [[ -n "${p:-}" ]] && PROFILE="$p"
        [[ -n "${c:-}" ]] && CHANNEL="$c"
        ;;
      13) cmd_check || true ;;
      14) cmd_rebuild || true ;;
      15) cmd_repair || true ;;
      16) cmd_reinstall || true ;;
      17) cmd_logs || true ;;
      18) cmd_backup || true ;;
      19)
        read -r -p "Backup zip path: " z
        CMD_ARG="$z" cmd_restore || true
        ;;
      20) cmd_scan || true ;;
      21) cmd_upgrade || true ;;
      0|q|Q) exit 0 ;;
      *) warn "Unknown choice" ;;
    esac
  done
}

cmd_completion() {
  local shell="$1" dir
  # Installed layout ships completions next to the script; packaged wrappers set SERNICORD_COMPLETIONS.
  dir="${SERNICORD_COMPLETIONS:-$ROOT/completions}"
  case "$shell" in
    bash) cat "$dir/sernicord.bash" ;;
    zsh)  cat "$dir/_sernicord" ;;
    fish) cat "$dir/sernicord.fish" ;;
    *) die "Usage: sernicord completion bash|zsh|fish" ;;
  esac
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
main() {
  ORIG_ARGS=("$@")
  parse_args "$@"
  case "$CMD" in
    version) echo "sernicord ${VERSION}"; return ;;
    completion) cmd_completion "${CMD_ARG:-}"; return ;;
  esac
  mkdir -p "$ROOT/data" "$CLIENTS_DIR"

  case "$CMD" in
    help) usage ;;
    menu) cmd_menu ;;
    setup) cmd_setup ;;
    sync-plugins|sync) sync_plugins ;;
    build) ensure_toolchain; ensure_target_clone; build_target ;;
    watch) ensure_toolchain; ensure_target_clone; apply_profile_env; start_watch ;;
    inject) ensure_toolchain; apply_profile_env; ensure_target_clone; inject_target ;;
    uninject) ensure_toolchain; apply_profile_env; ensure_target_clone; uninject_target ;;
    launch) ensure_toolchain; apply_profile_env; launch_discord ;;
    fix) cmd_fix ;;
    check) cmd_check ;;
    rebuild) cmd_rebuild ;;
    repair) cmd_repair ;;
    reinstall) cmd_reinstall ;;
    restart) ensure_toolchain; apply_profile_env; stop_all; cmd_dev ;;
    logs|log) cmd_logs ;;
    update) cmd_update ;;
    upgrade|self-update) cmd_upgrade ;;
    doctor) cmd_doctor ;;
    status) cmd_status ;;
    stop) stop_all ;;
    profiles) cmd_profiles ;;
    backup) cmd_backup ;;
    restore) cmd_restore ;;
    scan) cmd_scan ;;
    clean-build) cmd_clean_build ;;
    dev|up|start|"") cmd_dev ;;
    *)
      usage
      die "Unknown command: $CMD"
      ;;
  esac
}

main "$@"
