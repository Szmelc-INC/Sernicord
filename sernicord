# Profile XDG tree parts (config/share/cache/state) — legacy layout for the
# default profile, data/profiles/<name> otherwise
profile_xdg_parent() {
  if [[ "$PROFILE" == "$DEFAULT_PROFILE" && -d "$ROOT/data/config" ]]; then
    echo "$ROOT/data"
  else
    echo "$(profile_root "$PROFILE")"
  fi
}

vencord_data_dir() {
  echo "$(profile_xdg_parent)/config/Vencord"
}

profile_discord_dir() {
  resolve_discord_config "$PROFILE"
}

# Volatile / huge Chromium paths excluded from backups unless --full
BACKUP_EXCLUDES=(
  'config/*/Cache/*' 'config/*/Code Cache/*' 'config/*/GPUCache/*' 'config/*/GPUPersistentCache/*'
  'config/*/DawnGraphiteCache/*' 'config/*/DawnWebGPUCache/*' 'config/*/Crashpad/*'
  'config/*/blob_storage/*' 'config/*/Service Worker/*' 'config/*/Shared Dictionary/*'
  'config/*/Dictionaries/*' 'config/*/ShaderCache/*' 'config/*/discord_asset_cache/*'
  'config/discord/module_data/*' 'config/discord/logs/*' 'config/discord/download/*'
  'config/discord/1.0.*' 'config/discord/app-*' 'config/discord/Discord' 'config/discord/updater.node'
  'config/discord/Singleton*' 'config/discord/sentry/*'
  'config/thorium' 'config/thorium/*'
  'cache/*' 'cache' 'share/pnpm/*' '*.pid' 'watch*.log' '*/Singleton*' '*/.DS_Store'
)

make_zip() {
  # make_zip <out.zip> <dir> <path...> — append paths to a zip, relative to dir
  local out="$1" dir="$2"; shift 2
  if command -v zip >/dev/null 2>&1; then
    (cd "$dir" && zip -q -r -u "$out" "$@")
  else
    BACKUP_EXCLUDES="${BACKUP_EXCLUDES[*]}" python3 -I - "$out" "$dir" "$@" <<'PY'
import fnmatch, os, sys, zipfile
out, root, paths = sys.argv[1], sys.argv[2], sys.argv[3:]
excludes = os.environ["BACKUP_EXCLUDES"].split()
def excluded(rel):
    return any(fnmatch.fnmatch(rel, pat) for pat in excludes)
with zipfile.ZipFile(out, "a", zipfile.ZIP_DEFLATED) as z:
    for p in paths:
        for base, _, files in os.walk(os.path.join(root, p)):
            for f in files:
                full = os.path.join(base, f)
                rel = os.path.relpath(full, root)
                if not excluded(rel):
                    z.write(full, rel)
PY
  fi
}

dir_size() {
  du -sh "$1" 2>/dev/null | cut -f1 || echo "?"
}

cmd_backup() {
  local out="${CMD_ARG:-}" parent vc dd tmp manifest
  [[ -n "$out" ]] || out="$ROOT/data/backups/sernicord-backup-$(date +%Y%m%d-%H%M%S).zip"
  mkdir -p "$(dirname "$out")"
  parent=$(profile_xdg_parent)
  vc=$(vencord_data_dir)
  dd=$(profile_discord_dir)

  hdr "Sernicord backup → $out"
  if (( BACKUP_PLUGINS_ONLY )); then
    info "Scope: plugins/ only"
  else
    info "Scope: profile configs (discord + Vencord settings, themes, QuickCSS, session)"
    (( BACKUP_FULL )) && info "      + full caches (--full)" || note "heavy Chromium caches skipped (use --full to include)"
    kv "profile" "$PROFILE"
    kv "target" "$TARGET"
    kv "discord data" "$dd ${DIM}($(dir_size "$dd" 2>/dev/null))${RST}"
    [[ -d "$vc" ]] && kv "vencord data" "$vc ${DIM}($(dir_size "$vc"))${RST}"
    [[ -d "$parent/state" ]] && kv "state" "$parent/state"
  fi
  kv "plugins" "$PLUGINS_DIR ${DIM}($(dir_size "$PLUGINS_DIR"))${RST}"

  rm -f "$out"
  tmp=$(mktemp -d)
  manifest=$(printf '%s' "{
  \"tool\": \"sernicord\",
  \"version\": \"${VERSION}\",
  \"created\": \"$(date -Is)\",
  \"target\": \"${TARGET}\",
  \"profile\": \"${PROFILE}\",
  \"full\": ${BACKUP_FULL},
  \"pluginsOnly\": ${BACKUP_PLUGINS_ONLY}
}")
  printf '%s\n' "$manifest" > "$tmp/manifest.json"

  if (( BACKUP_PLUGINS_ONLY )); then
    make_zip "$out" "$ROOT" plugins || die "zip failed (plugins/)"
  else
    local parts=(config)
    [[ -d "$parent/share" ]] && parts+=(share)
    [[ -d "$parent/state" ]] && parts+=(state)
    (( BACKUP_FULL )) && [[ -d "$parent/cache" ]] && parts+=(cache)
    if command -v zip >/dev/null 2>&1; then
      local -a xargs=(-x)
      local e
      for e in "${BACKUP_EXCLUDES[@]}"; do xargs+=("$e"); done
      (cd "$parent" && zip -q -r "$out" "${parts[@]}" "${xargs[@]}")
    else
      make_zip "$out" "$parent" "${parts[@]}"
    fi
    make_zip "$out" "$ROOT" plugins || die "zip failed (plugins/)"
  fi
  make_zip "$out" "$tmp" manifest.json
  rm -rf "$tmp"

  [[ -s "$out" ]] || die "Backup zip is empty/missing: $out"
  ok "Backup written: $out ($(dir_size "$out"))"
  note "Keep it private — it contains your Discord session (Cookies, Local Storage)."
}

restore_plugins_from() {
  # restore_plugins_from <staged-plugins-dir>
  local src="$1" d name count=0
  for d in "$src"/*/; do
    [[ -d "$d" ]] || continue
    name=$(basename "$d")
    [[ "$name" == .* ]] && continue
    if [[ -d "$PLUGINS_DIR/$name" ]] && ! (( ASSUME_YES )); then
      confirm "Overwrite existing plugin '$name'?" || { info "  kept  $name"; continue; }
    fi
    mkdir -p "$PLUGINS_DIR/$name"
    rsync -a "$d"/ "$PLUGINS_DIR/$name/"
    count=$((count + 1))
    ok "  plugin  $name"
  done
  (( count )) || warn "No plugin directories found in backup"
}

cmd_restore() {
  local zip="${CMD_ARG:-}" tmp parent
  [[ -n "$zip" ]] || die "Usage: ./sernicord restore <file.zip> [--plugins-only|--data-only] [-y]"
  [[ -f "$zip" ]] || die "Backup not found: $zip"
  (( RESTORE_PLUGINS_ONLY && RESTORE_DATA_ONLY )) && die "--plugins-only and --data-only are mutually exclusive"
  tmp=$(mktemp -d)
  hdr "Sernicord restore ← $zip"
  info "Extracting to $tmp"
  if command -v unzip >/dev/null 2>&1; then
    unzip -q "$zip" -d "$tmp" || die "unzip failed"
  else
    python3 -I - "$zip" "$tmp" <<'PY'
import os, sys, zipfile
with zipfile.ZipFile(sys.argv[1]) as z:
    for m in z.infolist():
        dest = os.path.realpath(os.path.join(sys.argv[2], m.filename))
        if not dest.startswith(os.path.realpath(sys.argv[2]) + os.sep):
            sys.exit(f"unsafe path in zip: {m.filename}")
    z.extractall(sys.argv[2])
PY
  fi
  [[ -f "$tmp/manifest.json" ]] || warn "No manifest.json — restoring as generic zip"

  if (( ! RESTORE_DATA_ONLY )); then
    if [[ -d "$tmp/plugins" ]]; then
      info "Restoring plugins/ → $PLUGINS_DIR"
      confirm "Restore plugins from backup?" || die "Aborted"
      restore_plugins_from "$tmp/plugins"
    else
      (( RESTORE_PLUGINS_ONLY )) && warn "Backup has no plugins/ directory"
    fi
  fi
  if (( ! RESTORE_PLUGINS_ONLY )); then
    if [[ -d "$tmp/config" ]]; then
      parent=$(profile_xdg_parent)
      kv "target profile" "$PROFILE → $parent"
      if (( RESTORE_DATA_ONLY )) || confirm "Restore profile data (configs/settings/themes/session) into '${PROFILE}'? Existing files are overwritten"; then
        info "Restoring profile data"
        for part in config share state; do
          [[ -d "$tmp/$part" ]] || continue
          mkdir -p "$parent/$part"
          rsync -a "$tmp/$part"/ "$parent/$part/"
          ok "  $part/"
        done
        # stale Chromium singletons from a live session would block launch
        local cfg; cfg=$(profile_discord_dir)
        rm -f "$cfg"/Singleton{Lock,Cookie,Socket} 2>/dev/null || true
        ok "Cleaned stale singleton locks"
      else
        die "Aborted"
      fi
    else
      (( RESTORE_DATA_ONLY )) && die "Backup has no profile data (config/)"
    fi
  fi
  rm -rf "$tmp"
  ok "Restore finished"
  info "Next: ./sernicord build  (or ./sernicord dev)"
}

