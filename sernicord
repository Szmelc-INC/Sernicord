}

expand_path() { echo "${1/#\~/$HOME}"; }

trace_caps() {
  # trace_caps <root> → space-separated capabilities
  local r="$1" caps=""
  [[ -d "$r/settings" && -f "$r/settings/settings.json" ]] && caps+=" settings"
  [[ -f "$r/settings/quickCss.css" ]] && caps+=" quickcss"
  ls "$r"/themes/*.theme.css >/dev/null 2>&1 && caps+=" themes"
  [[ -d "$r/plugins" ]] && caps+=" bd-plugins"
  # discord-style dir: sibling Vencord dir counts as its vencord data
  if [[ -d "$r/Vencord/settings" || -d "$r/Vencord/themes" ]]; then caps+=" vencord-data"; fi
  [[ -f "$r/Cookies" || -d "$r/Local Storage" ]] && caps+=" cache"
  [[ -d "$r/src/userplugins" ]] && caps+=" userplugins"
  [[ -d "$r/plugins" && -f "$r/sernicord" ]] && caps+=" sernicord-plugins"
  echo "$caps"
}

cmd_scan() {
  local line kind path real caps found=0 row kindcol
  hdr "Sernicord scan — Discord / Vencord traces on this system"
  while IFS='|' read -r kind path; do
    real=$(expand_path "$path")
    [[ -e "$real" ]] || continue
    [[ "$real" == "$ROOT" ]] && continue
    caps=$(trace_caps "$real")
    [[ -z "$caps" ]] && continue
    found=$((found + 1))
    printf '  %s%-13s%s %s\n' "$ACC$BLD" "$kind" "$RST" "$real"
    kv "size" "$(dir_size "$real")"
    kv "has" "${SILVER}${caps# }${RST}"
    echo
  done < <(scan_candidates)

  # legacy default layout of this checkout also holds live data
  if [[ -d "$ROOT/data/config/discord" ]]; then
    printf '  %s%-13s%s %s\n' "$AQUA$BLD" "this repo" "$RST" "$ROOT/data/config (legacy default profile)"
  fi

  if (( found == 0 )); then
    warn "No other Discord/Vencord traces found"
    return 0
  fi
  note "Import (nothing is touched until you say so):"
  note "  ./sernicord scan --import settings|themes|quickcss|cache|plugins|all --from <dir> [-y]"
  (( ${#IMPORT_SCOPE} )) || return 0
  [[ -n "$IMPORT_FROM" ]] || die "--import needs --from <dir>"
  import_trace
}

import_trace() {
  local src kind r vc dest parent
  src=$(expand_path "$IMPORT_FROM")
  [[ -e "$src" ]] || die "--from path not found: $src"
  parent=$(profile_xdg_parent)
  vc=$(vencord_data_dir)
  dest="$vc"
  # Normalize: discord config dir → its sibling Vencord data dir
  if [[ ! -d "$src/settings" && ! -d "$src/themes" ]]; then
    if [[ -d "$src/Vencord" ]]; then r="$src/Vencord"; fi
    if [[ -d "$src/src/userplugins" ]]; then r="$src"; fi
  fi
  r="${r:-$src}"

  hdr "Import '$IMPORT_SCOPE' ← $src"
  kv "into profile" "$PROFILE"

  local do_settings=0 do_themes=0 do_quick=0 do_cache=0 do_plugins=0
  case "$IMPORT_SCOPE" in
    all) do_settings=1; do_themes=1; do_quick=1; do_cache=1; do_plugins=1 ;;
    settings) do_settings=1 ;;
    themes) do_themes=1 ;;
    quickcss) do_quick=1 ;;
    cache) do_cache=1 ;;
    plugins) do_plugins=1 ;;
  esac

  confirm "Import '$IMPORT_SCOPE' from $src into profile '$PROFILE'?" || die "Aborted"

  if (( do_settings )); then
    if [[ -f "$r/settings/settings.json" ]]; then
      mkdir -p "$dest/settings"
      [[ -f "$dest/settings/settings.json" ]] && cp "$dest/settings/settings.json" "$dest/settings/settings.json.pre-import"
      cp "$r/settings/settings.json" "$dest/settings/settings.json"
      ok "settings.json imported (previous copy kept as .pre-import)"
      note "plugin enablement + theme links came along; run ./sernicord build"
    else
      warn "no settings/settings.json under $r"
    fi
  fi
  if (( do_quick )); then
    if [[ -f "$r/settings/quickCss.css" ]]; then
      mkdir -p "$dest/settings"
      cp "$r/settings/quickCss.css" "$dest/settings/quickCss.css"
      ok "QuickCSS imported"
    else
      warn "no settings/quickCss.css under $r"
    fi
  fi
  if (( do_themes )); then
    local t count=0
    mkdir -p "$dest/themes"
    for t in "$r"/themes/*.theme.css; do
      [[ -f "$t" ]] || continue
      cp -n "$t" "$dest/themes/"
      count=$((count + 1))
    done
    (( count )) && ok "$count theme(s) imported into $dest/themes" || warn "no *.theme.css under $r/themes"
  fi
  if (( do_cache )); then
    local d="$src" target
    # accept either the discord config dir itself or a parent containing discord/
    [[ ! -f "$d/Cookies" && ! -d "$d/Local Storage" && -d "$d/discord" ]] && d="$d/discord"
    if [[ -f "$d/Cookies" || -d "$d/Local Storage" ]]; then
      target=$(profile_discord_dir)
      confirm "Copy Discord session (login) from $d into $target? This overwrites the current session" || die "Aborted"
      mkdir -p "$target"
      for item in Cookies Cookies-journal "Local Storage" "Session Storage" IndexedDB Preferences "Local State" settings.json; do
        [[ -e "$d/$item" ]] || continue
        rm -rf "$target/$item"
        cp -a "$d/$item" "$target/"
        ok "  $item"
      done
      ok "Session imported — launch with: ./sernicord launch"
    else
      warn "no Discord session data found under $src"
    fi
  fi
  if (( do_plugins )); then
    local up="" p
    [[ -d "$src/plugins" && -f "$src/sernicord" ]] && up="$src/plugins"
    [[ -z "$up" && -d "$src/src/userplugins" ]] && up="$src/src/userplugins"
    if [[ -n "$up" ]]; then
      info "Importing plugins from $up → $PLUGINS_DIR"
      restore_plugins_from "$up"
      note "run ./sernicord check to type-check imported plugins"
    else
      warn "no importable plugins (Sernicord checkout plugins/ or a Vencord clone src/userplugins)"
      [[ -d "$src/plugins" ]] && note "BetterDiscord .plugin.js files cannot run on Vencord — skipping"
    fi
  fi
  ok "Import finished"
}

