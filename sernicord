#!/usr/bin/env bash
# Sernicord — universal Discord mod sideloader
# Default: build Vencord (dev) with all Sernicord plugins, inject into an
# isolated Discord profile, watch, and launch. Never touches system Discord
# unless you explicitly pass --system (and confirm).
set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
cd "$ROOT"

VERSION="1.3.0"
PLUGINS_DIR="$ROOT/plugins"
CLIENTS_DIR="$ROOT/clients"
DEFAULT_PROFILE="sernicord"
DEFAULT_TARGET="vencord"
DEFAULT_CHANNEL="stable"

# ---------------------------------------------------------------------------
# Color engine — Szmelc brand palette
#   accent  cyan      #1f8a8a (CLI lift of #105c5c)
#   danger  red       #b83a3a (CLI lift of #750f0f)
#   silver  #c0c0c0   (labels / secondary)
#   aqua    #7fffd4   (sparingly, highlights)
# Honors --no-color, NO_COLOR, non-TTY output and terminal color depth.
# ---------------------------------------------------------------------------
for _a in "$@"; do
  case "$_a" in
    --no-color|--color=never) NO_COLOR=1 ;;
    --color=always) FORCE_COLOR=1 ;;
  esac
done
unset _a

color_depth() {
  if [[ -n "${FORCE_COLOR:-}" ]]; then printf '3'; return; fi
  [[ -t 1 && -z "${NO_COLOR:-}" ]] || return 1
  case "${COLORTERM:-}" in truecolor|24bit) printf '3' ;;
  *) [[ "${TERM:-}" == *256color* ]] && printf '2' || printf '1' ;;
  esac
}

if depth=$(color_depth) && [[ -n "$depth" ]]; then
  GRN=$'\033[32m'; YLW=$'\033[33m'; BLD=$'\033[1m'; RST=$'\033[0m'; DIM=$'\033[2m'; ITL=$'\033[3m'
  case "$depth" in
    3)
      ACC=$'\033[38;2;31;138;138m'; DANGER=$'\033[38;2;184;58;58m'
      AQUA=$'\033[38;2;127;255;212m'; SILVER=$'\033[38;2;170;170;170m'
      ;;
    2)
      ACC=$'\033[38;5;30m'; DANGER=$'\033[38;5;124m'; AQUA=$'\033[38;5;86m'; SILVER=$'\033[38;5;145m'
      ;;
    *)
      ACC=$'\033[36m'; DANGER=$'\033[31m'; AQUA=$'\033[36m'; SILVER=$'\033[37m'; DIM=$'\033[0m'
      ;;
  esac
else
  GRN=; YLW=; BLD=; RST=; DIM=; ITL=; ACC=; DANGER=; AQUA=; SILVER=
fi
unset depth
# Compat aliases used across the script
RED=$DANGER; CYN=$ACC; MAG=$ACC; BLU=$ACC

log()  { printf '%s\n' "$*"; }
info() { printf '%s==>%s %s\n' "$ACC" "$RST" "$*"; }
ok()   { printf '%s%s✔%s %s\n' "$GRN" "$BLD" "$RST" "$*"; }
warn() { printf '%s%s⚠%s  %s\n' "$YLW" "$BLD" "$RST" "$*" >&2; }
die()  { printf '%s%s✖%s  %s\n' "$DANGER" "$BLD" "$RST" "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "Missing required command: $1"; }

# Section header: ── TITLE ─────────────
hdr() {
  local title="$1" width=60 line
  printf '%s' "$ACC$BLD"
  printf '%.0s─' $(seq 1 2)
  printf ' %s ' "$title"
  line=$(( width - ${#title} - 3 ))
  (( line > 0 )) && printf '%.0s─' $(seq 1 $line)
  printf '%s\n' "$RST"
}

# Aligned key : value row
kv() { printf '  %s%-22s%s %s%s%s\n' "$SILVER" "$1" "$RST" "$2" "${3:-}" "${4:-}"; }

# Muted note
note() { printf '  %s%s%s\n' "$DIM" "$*" "$RST"; }

# Profile env overrides XDG_* for Discord only. Build tools (pnpm, node) must see
# the host XDG dirs, or pnpm self-installs a second, broken copy under data/share.
XDG_VARS=(XDG_CONFIG_HOME XDG_DATA_HOME XDG_CACHE_HOME XDG_STATE_HOME)
for _v in "${XDG_VARS[@]}"; do
  if [[ -n "${!_v+x}" ]]; then printf -v "HOST_$_v" '%s' "${!_v}"; fi
done
unset _v

host_env() {
  local v h
  for v in "${XDG_VARS[@]}"; do
    h="HOST_$v"
    if [[ -n "${!h+x}" ]]; then export "$v=${!h}"; else unset "$v"; fi
  done
}

# Run a build tool with the host environment
host() { ( host_env; "$@" ); }

# Build artifacts Discord loads at startup; a missing one crashes the main process
DIST_FILES=(patcher.js preload.js renderer.js renderer.css)

# ---------------------------------------------------------------------------
# Target registry
# ---------------------------------------------------------------------------
target_repo() {
  case "$1" in
    vencord)     echo "https://github.com/Vendicated/Vencord.git" ;;
    equicord)    echo "https://github.com/Equicord/Equicord.git" ;;
    *) die "Unknown target: $1 (known: vencord, equicord)" ;;
  esac
}

target_src() {
  # Prefer legacy ./vencord path if present, else clients/<name>
  local name="$1"
  if [[ -d "$ROOT/$name/.git" || -f "$ROOT/$name/package.json" ]]; then
    echo "$ROOT/$name"
  else
    echo "$CLIENTS_DIR/$name"
  fi
}

target_userplugins() {
  echo "$(target_src "$1")/src/userplugins"
}

profile_root() {
  echo "$ROOT/data/profiles/$1"
}

profile_xdg() {
  local p
  p=$(profile_root "$1")
  echo "$p"
}

discord_config_for() {
  # Isolated Discord user-data / config dir for a profile
  echo "$(profile_root "$1")/config/discord"
}

# Legacy single-profile layout used by older dev.sh
legacy_discord_config() {
  echo "$ROOT/data/config/discord"
}

resolve_discord_config() {
  local profile="$1"
  local legacy
  legacy=$(legacy_discord_config)
  if [[ "$profile" == "$DEFAULT_PROFILE" && -x "$legacy/Discord" ]]; then
    echo "$legacy"
  else
    echo "$(discord_config_for "$profile")"
  fi
}

bootstrap_bin() {
  echo "$ROOT/discord-app/Discord/updater_bootstrap"
}

launcher_bin() {
  echo "$ROOT/discord-app/Discord/discord"
}

