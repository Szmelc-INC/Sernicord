  ${SILVER}--no-launch${RST}              Skip launching Discord (dev/up)
  ${SILVER}--no-watch${RST}               Skip starting file watch (dev/up)
  ${SILVER}--prod${RST}                   Production build instead of --dev
  ${SILVER}--no-color${RST}               Disable colors (also honors ${SILVER}NO_COLOR${RST})
  ${SILVER}-y, --yes${RST}                Assume yes for prompts
