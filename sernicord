${DIM}     universal Discord mod sideloader${RST}

${ACC}${BLD}Usage${RST}   ${BLD}./sernicord${RST} ${SILVER}[command]${RST} ${DIM}[options]${RST}

${ACC}── Development ─────────────────────────────────────${RST}
