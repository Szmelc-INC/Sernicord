scan_candidates() {
  cat <<EOF
vencord|~/.config/Vencord
vencord|~/.config/Equicord
vencord|~/.config/vesktop/Vencord
vencord|~/.config/Vesktop/Vencord
discord|~/.config/discord
discord|~/.config/discordPTB
discord|~/.config/discordcanary
discord|~/.config/Vesktop
discord|~/.config/vesktop
discord|~/.config/WebCord
discord|~/.var/app/com.discordapp.Discord/config/discord
discord|~/.var/app/com.vencord.Vesktop/config/vesktop
betterdiscord|~/.config/BetterDiscord
sernicord|~/Projects-2/VENCORD
sernicord|~/Projects-3/VENCORD
sernicord|~/Projects-4/VENCORD
sernicord|~/Projects-5/VENCORD
